# Сайт
APP_NAME=HiMeet Объявления
APP_DOMAIN=https://ads.himeet.online
APP_ENV=development
PORT=3000

# База данных (сервер в РФ, 152-ФЗ)
DATABASE_URL=postgresql://ads:password@localhost:5432/ads

# Сессии
JWT_SECRET=change_me_long_random_string
SESSION_TTL_DAYS=30

# Вход по номеру телефона РФ (основной способ)
SMS_PROVIDER=
SMS_API_KEY=
SMS_SENDER=

# ЕСИА / Госуслуги (включать только после получения продуктивного доступа)
ESIA_ENABLED=false
ESIA_BASE_URL=
ESIA_CLIENT_ID=
ESIA_REDIRECT_URI=https://ads.himeet.online/auth/esia/callback
ESIA_SCOPE=fullname mobile
ESIA_CERT_PATH=
ESIA_KEY_PATH=

# Платежи самозанятого: ЮKassa + СБП, чеки НПД
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
YOOKASSA_RETURN_URL=https://ads.himeet.online/payments/return
YOOKASSA_WEBHOOK_SECRET=
NPD_INN=
NPD_DEVICE_ID=
NPD_DEVICE_OS=

# Тарифы в рублях
PRICE_FIRST_AD=0
PRICE_EXTRA_AD=99
PRICE_BOOST=49
PRICE_PRO_MONTH=299

# RuStore Push
RUSTORE_PUSH_PROJECT_ID=
RUSTORE_PUSH_KEY_ID=
